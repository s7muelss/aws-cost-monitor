{
  "name": "aws-cost-alert",
  "version": "1.0.0",
  "description": "Monitor AWS costs and get Slack/email alerts before your bill explodes 🚨",
  "main": "dist/index.js",
  "bin": {
    "aws-cost-alert": "./dist/cli/index.js"
  },
  "scripts": {
