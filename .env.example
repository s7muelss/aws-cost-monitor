# Limite de custo que dispara o alerta (em dólares)
COST_THRESHOLD_USD=50

# Região da AWS
AWS_REGION=us-east-1

# URL do Webhook do Slack (opcional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Email para alertas via SNS (opcional)
ALERT_EMAIL=seu@email.com

# ARN do tópico SNS (obrigatório para alertas por email)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:aws-cost-alerts
